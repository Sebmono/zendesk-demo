# Zendesk API token, from Admin Center > Apps and integrations > Zendesk API
ZENDESK_API_TOKEN=your_zendesk_api_token_here

# Email address of the Zendesk admin the token belongs to
ZENDESK_EMAIL=admin@example.com

# Zendesk subdomain: for https://acme.zendesk.com use "acme"
ZENDESK_SUBDOMAIN=your-subdomain

# Anthropic API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the Claude model used for generated customer replies
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
